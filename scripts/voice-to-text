#!/bin/bash
# voice-to-text <audio-file> [--lang auto|ru|tt|en|ar]
#
# Speech-to-text router for all bots on this VPS. Installed to /usr/local/bin
# (not /root/...: /root is mode 700, other bot users could not execute it there).
# Two local services, both systemd socket activation (start on the first request, exit when idle):
#   gigaam-asr (127.0.0.1:9003, gigaam-asr/)  language ID (VoxLingua107) + Russian (GigaAM v3, with punctuation)
#   tatar-asr  (127.0.0.1:9002, tatar-asr/)   Omnilingual 300M: Tatar, English, Arabic, ... (lowercase, no punctuation)
#
#   auto (default): language ID in gigaam-asr (/detect-language, ~0.3-2 s);
#                   ru (= ru+be+uk) with confidence >= 0.60 -> GigaAM,
#                   otherwise (tt, en, ar, ...) -> Omnilingual.
#   ru            : force GigaAM.
#   tt|en|ar      : force Omnilingual (no language hint there: one multilingual model).
# Fallback: gigaam-asr down (language ID or GigaAM failed) -> Omnilingual for any language (it knows Russian too).
# Only one service installed -> everything goes to it (GigaAM is Russian-only: other languages come out garbled).
# Nothing works -> error on stderr, exit 1.
# stdout: transcript only. stderr: one short status line per step. Decisions -> syslog (tag voice-to-text).
#
# Config: /etc/voice-to-text.conf (KEY=value lines, written by the installers):
#   GIGAAM_ENABLED=1  GIGAAM_URL=...  TATAR_ENABLED=1  TATAR_URL=...
#   LID_TIMEOUT=...  GIGAAM_TIMEOUT=...  TATAR_TIMEOUT=...  VTT_CONF_MIN_RU=0.60
# Environment variables with the same names take precedence over the file.
set -uo pipefail

CONF_FILE="${VTT_CONF_FILE:-/etc/voice-to-text.conf}"
if [ -r "$CONF_FILE" ]; then
  # parsed, not sourced: only known keys, no code execution
  while IFS='=' read -r k v; do
    case "$k" in
      GIGAAM_URL|GIGAAM_ENABLED|TATAR_URL|TATAR_ENABLED|LID_TIMEOUT|GIGAAM_TIMEOUT|TATAR_TIMEOUT|VTT_CONF_MIN_RU)
        v="${v%%#*}"; v="${v//[[:space:]]/}"; v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
        [ -z "${!k:-}" ] && printf -v "$k" '%s' "$v" ;;
    esac
  done < "$CONF_FILE"
fi

GIGAAM_URL="${GIGAAM_URL:-http://127.0.0.1:9003}"
TATAR_URL="${TATAR_URL:-http://127.0.0.1:9002}"
GIGAAM_ENABLED="${GIGAAM_ENABLED:-1}"
TATAR_ENABLED="${TATAR_ENABLED:-0}"
LID_TIMEOUT="${LID_TIMEOUT:-120}"
GIGAAM_TIMEOUT="${GIGAAM_TIMEOUT:-600}"
TATAR_TIMEOUT="${TATAR_TIMEOUT:-600}"
# VoxLingua gives Russian recordings ru >= 0.99 and Tatar ones <= 0.05
CONF_MIN_RU="${VTT_CONF_MIN_RU:-0.60}"
TAG="[voice-to-text]"

usage() { echo "usage: voice-to-text <audio-file> [--lang auto|ru|tt|en|ar]" >&2; exit 2; }

FILE="" LANG_OPT="auto"
while [ $# -gt 0 ]; do
  case "$1" in
    --lang) [ $# -ge 2 ] || usage; LANG_OPT="$2"; shift 2 ;;
    --lang=*) LANG_OPT="${1#--lang=}"; shift ;;
    -h|--help) usage ;;
    *) [ -z "$FILE" ] || usage; FILE="$1"; shift ;;
  esac
done
[ -n "$FILE" ] || usage
case "$LANG_OPT" in auto|ru|tt|en|ar) ;; *) echo "$TAG unknown --lang '$LANG_OPT'" >&2; usage ;; esac
if [ ! -r "$FILE" ]; then echo "$TAG cannot read file: $FILE" >&2; exit 1; fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/vtt.XXXXXX")" || exit 1
trap 'rm -rf "$TMP"' EXIT

now() { date +%s.%N; }
elapsed() { awk -v a="$1" -v b="$(now)" 'BEGIN{printf "%.1f", b-a}'; }
note() { echo "$TAG $*" >&2; logger -t voice-to-text -- "user=$(id -un) file=$(basename -- "$FILE") $*" 2>/dev/null || true; }
ge() { awk -v c="$1" -v m="$2" 'BEGIN{exit !(c+0 >= m+0)}'; }
fmt2() { awk -v c="$1" 'BEGIN{printf "%.2f", c}'; }
errtxt() { cat "$TMP/err" "$TMP/out" 2>/dev/null | head -c 200 | tr "\n" " "; }
hdr() { tr -d '\r' < "$TMP/hdr" 2>/dev/null | awk -F': ' -v k="$1" 'tolower($1)==tolower(k){print $2}' | tail -1; }
# cold start / queue info from X-Load-Wait / X-Queue-Wait headers (both services send them)
waits() {
  local lw qw e=""
  lw="$(hdr X-Load-Wait)"; qw="$(hdr X-Queue-Wait)"
  ge "${lw:-0}" 1.0 && e="cold start ${lw}s, "
  ge "${qw:-0}" 1.0 && e="${e}queued ${qw}s, "
  printf '%s' "$e"
}

post() {  # $1 = url, $2 = timeout; body -> $TMP/out, headers -> $TMP/hdr, curl errors -> $TMP/err
  rm -f "$TMP/out" "$TMP/hdr" "$TMP/err"
  curl -sS --fail-with-body --max-time "$2" -X POST -F "audio_file=@${FILE}" -D "$TMP/hdr" "$1" \
    -o "$TMP/out" 2>"$TMP/err"
}

# Engines: on success print the transcript to stdout, log, return 0.
run_gigaam() {
  local t0; t0="$(now)"
  if post "${GIGAAM_URL}/asr?language=ru" "$GIGAAM_TIMEOUT"; then
    note "$PREFIX → gigaam ($(waits)infer $(hdr X-Infer-Sec)s, total $(elapsed "$t0")s)"
    cat "$TMP/out"; return 0
  fi
  note "$PREFIX → gigaam FAILED after $(elapsed "$t0")s ($(errtxt))"; return 1
}
run_tatar() {
  local t0; t0="$(now)"
  if post "${TATAR_URL}/asr" "$TATAR_TIMEOUT"; then
    note "$PREFIX → omnilingual ($(waits)infer $(hdr X-Infer-Sec)s, total $(elapsed "$t0")s)"
    cat "$TMP/out"; return 0
  fi
  note "$PREFIX → omnilingual FAILED after $(elapsed "$t0")s ($(errtxt))"; return 1
}

if [ "$GIGAAM_ENABLED" != 1 ] && [ "$TATAR_ENABLED" != 1 ]; then
  note "ERROR: no speech service installed — run gigaam-asr/install-gigaam-asr.sh (claude-vps-starter)"
  exit 1
fi

# choose the engine
if [ "$GIGAAM_ENABLED" != 1 ]; then
  ENGINE="tatar"; PREFIX="lang=$LANG_OPT (gigaam off)"
elif [ "$LANG_OPT" = "auto" ] && [ "$TATAR_ENABLED" != 1 ]; then
  # GigaAM is the only engine: language ID would not change anything
  ENGINE="gigaam"; PREFIX="lang=ru (default, tatar off)"
elif [ "$LANG_OPT" = "auto" ]; then
  ENGINE="tatar"
  T0="$(now)"
  if post "${GIGAAM_URL}/detect-language" "$LID_TIMEOUT" && \
     read -r DET CONF RU < <(python3 -c 'import json,sys
d=json.load(open(sys.argv[1])); print(d["language_code"], d.get("confidence",0), d.get("ru",0))' "$TMP/out" 2>/dev/null); then
    LW="$(hdr X-Load-Wait)"; if ge "${LW:-0}" 1.0; then LW=", cold start ${LW}s"; else LW=""; fi
    PREFIX="lang=$DET conf=$(fmt2 "$CONF") ru=$(fmt2 "$RU") (lid $(elapsed "$T0")s${LW})"
    ge "$RU" "$CONF_MIN_RU" && ENGINE="gigaam"
  else
    PREFIX="lang=? (language ID FAILED after $(elapsed "$T0")s: $(errtxt))"
  fi
elif [ "$LANG_OPT" = ru ] || [ "$TATAR_ENABLED" != 1 ]; then
  ENGINE="gigaam"; PREFIX="lang=$LANG_OPT (forced)"
  [ "$LANG_OPT" != ru ] && PREFIX="$PREFIX, tatar off — GigaAM is Russian-only"
else
  ENGINE="tatar"; PREFIX="lang=$LANG_OPT (forced)"
fi

if [ "$ENGINE" = gigaam ]; then
  run_gigaam && exit 0
  [ "$TATAR_ENABLED" = 1 ] || { note "ERROR: gigaam-asr failed; check: systemctl status gigaam-asr.socket"; exit 1; }
  PREFIX="$PREFIX, fallback"
fi
run_tatar && exit 0
note "ERROR: speech recognition failed — check: systemctl status gigaam-asr.socket tatar-asr.socket; journalctl -u gigaam-asr -u tatar-asr -n 50"
exit 1
