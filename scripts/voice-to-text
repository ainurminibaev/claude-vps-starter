#!/bin/bash
# voice-to-text <audio-file> [--lang auto|ru|tt|en|ar]
#
# Speech-to-text router for all bots on this VPS. Installed to /usr/local/bin
# (not /root/...: /root is mode 700, other bot users could not execute it there).
#
#   auto (default):
#     Tatar service enabled  -> whisper /detect-language; if language is ru/en/ar
#                               with confidence >= 0.80 -> whisper /asr in that
#                               language, otherwise -> Tatar service (127.0.0.1:9002).
#     Tatar service disabled -> straight to whisper language=ru (no detection,
#                               same latency as the old whisper_via_api.sh).
#   tt       : force Tatar service.
#   ru|en|ar : force whisper with that language.
# If the Tatar service fails or times out -> fallback to whisper language=ru.
# stdout: transcript only. stderr: one short status line. Decisions -> syslog (tag voice-to-text).
#
# Config: /etc/voice-to-text.conf (KEY=value lines, written by tatar-asr/install-tatar-asr.sh):
#   TATAR_ENABLED=1   WHISPER_URL=...   TATAR_URL=...   TATAR_TIMEOUT=...
#   WHISPER_TIMEOUT=...   VTT_CONF_MIN=0.80
# Environment variables with the same names take precedence over the file.
set -uo pipefail

CONF_FILE="${VTT_CONF_FILE:-/etc/voice-to-text.conf}"
if [ -r "$CONF_FILE" ]; then
  # parsed, not sourced: only known keys, no code execution
  while IFS='=' read -r k v; do
    case "$k" in
      WHISPER_URL|TATAR_URL|TATAR_ENABLED|TATAR_TIMEOUT|WHISPER_TIMEOUT|VTT_CONF_MIN)
        v="${v%%#*}"; v="${v//[[:space:]]/}"; v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
        [ -z "${!k:-}" ] && printf -v "$k" '%s' "$v" ;;
    esac
  done < "$CONF_FILE"
fi

WHISPER_URL="${WHISPER_URL:-http://127.0.0.1:9000}"
TATAR_URL="${TATAR_URL:-http://127.0.0.1:9002}"
TATAR_ENABLED="${TATAR_ENABLED:-0}"
TATAR_TIMEOUT="${TATAR_TIMEOUT:-600}"
WHISPER_TIMEOUT="${WHISPER_TIMEOUT:-600}"
CONF_MIN="${VTT_CONF_MIN:-0.80}"
TAG="[voice-to-text]"

usage() { echo "usage: voice-to-text <audio-file> [--lang auto|ru|tt|en|ar]" >&2; exit 2; }

FILE="" LANG_OPT="auto"
while [ $# -gt 0 ]; do
  case "$1" in
    --lang) [ $# -ge 2 ] || usage; LANG_OPT="$2"; shift 2 ;;
    --lang=*) LANG_OPT="${1#--lang=}"; shift ;;
    -h|--help) usage ;;
    *) [ -z "$FILE" ] || usage; FILE="$1"; shift ;;
  esac
done
[ -n "$FILE" ] || usage
case "$LANG_OPT" in auto|ru|tt|en|ar) ;; *) echo "$TAG unknown --lang '$LANG_OPT'" >&2; usage ;; esac
if [ ! -r "$FILE" ]; then echo "$TAG cannot read file: $FILE" >&2; exit 1; fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/vtt.XXXXXX")" || exit 1
trap 'rm -rf "$TMP"' EXIT

now() { date +%s.%N; }
elapsed() { awk -v a="$1" -v b="$(now)" 'BEGIN{printf "%.1f", b-a}'; }
note() { echo "$TAG $*" >&2; logger -t voice-to-text -- "user=$(id -un) file=$(basename -- "$FILE") $*" 2>/dev/null || true; }

whisper_asr() {  # $1 = language
  curl -sS --fail-with-body --max-time "$WHISPER_TIMEOUT" -X POST \
    -F "audio_file=@${FILE}" \
    "${WHISPER_URL}/asr?language=$1&output=txt&encode=true" -o "$TMP/out" 2>"$TMP/err"
}

tatar_asr() {
  curl -sS --fail-with-body --max-time "$TATAR_TIMEOUT" -X POST \
    -F "audio_file=@${FILE}" -D "$TMP/hdr" \
    "${TATAR_URL}/asr" -o "$TMP/out" 2>"$TMP/err"
}

hdr() { tr -d '\r' < "$TMP/hdr" 2>/dev/null | awk -F': ' -v k="$1" 'tolower($1)==tolower(k){print $2}' | tail -1; }

DET="" CONF="" ROUTE=""
if [ "$LANG_OPT" = "auto" ] && [ "$TATAR_ENABLED" != "1" ]; then
  # no Tatar service on this server: skip detection, behave like plain whisper ru
  ROUTE="ru"
  PREFIX="lang=ru (default, tatar off)"
elif [ "$LANG_OPT" = "auto" ]; then
  if curl -sS --fail --max-time 120 -X POST -F "audio_file=@${FILE}" \
       "${WHISPER_URL}/detect-language?encode=true" -o "$TMP/det" 2>"$TMP/err"; then
    read -r DET CONF < <(python3 -c 'import json,sys
d=json.load(open(sys.argv[1])); print(d.get("language_code","?"), d.get("confidence",0))' "$TMP/det" 2>/dev/null) || true
  fi
  DET="${DET:-?}" CONF="${CONF:-0}"
  if [[ "$DET" =~ ^(ru|en|ar)$ ]] && awk -v c="$CONF" -v m="$CONF_MIN" 'BEGIN{exit !(c+0 >= m+0)}'; then
    ROUTE="$DET"
  else
    ROUTE="tt"
  fi
  CONF_FMT="$(awk -v c="$CONF" 'BEGIN{printf "%.2f", c}')"
  PREFIX="lang=$DET conf=$CONF_FMT"
else
  ROUTE="$LANG_OPT"
  PREFIX="lang=$LANG_OPT (forced)"
fi

T0="$(now)"
if [ "$ROUTE" = "tt" ]; then
  if tatar_asr; then
    LW="$(hdr X-Load-Wait)"; IS="$(hdr X-Infer-Sec)"; QW="$(hdr X-Queue-Wait)"
    EXTRA=""
    awk -v x="${LW:-0}" 'BEGIN{exit !(x+0 >= 1.0)}' && EXTRA="cold start ${LW}s, "
    awk -v x="${QW:-0}" 'BEGIN{exit !(x+0 >= 1.0)}' && EXTRA="${EXTRA}queued ${QW}s, "
    note "$PREFIX → tatar (${EXTRA}infer ${IS:-?}s, total $(elapsed "$T0")s)"
    cat "$TMP/out"
    exit 0
  fi
  ERR="$(head -c 200 "$TMP/err" 2>/dev/null | tr '\n' ' ')"
  note "$PREFIX → tatar FAILED after $(elapsed "$T0")s (${ERR:-no details}) → fallback whisper ru"
  ROUTE="ru"; T0="$(now)"
  if whisper_asr ru; then
    note "fallback whisper ru done ($(elapsed "$T0")s)"
    cat "$TMP/out"; exit 0
  fi
  note "fallback whisper ru FAILED: $(head -c 200 "$TMP/err" "$TMP/out" 2>/dev/null | tr '\n' ' ')"
  exit 1
fi

if whisper_asr "$ROUTE"; then
  note "$PREFIX → whisper $ROUTE ($(elapsed "$T0")s)"
  cat "$TMP/out"
  exit 0
fi
note "$PREFIX → whisper $ROUTE FAILED: $(head -c 200 "$TMP/err" "$TMP/out" 2>/dev/null | tr '\n' ' ')"
exit 1
