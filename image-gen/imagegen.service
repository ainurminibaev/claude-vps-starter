[Unit]
Description=image-gen: генерация картинок через Codex на подписке ChatGPT
After=network-online.target
Wants=network-online.target

[Service]
User=imagegen
Group=imagegen
# Нужна, чтобы отдать сокет группе imagegen-users.
SupplementaryGroups=imagegen-users
Environment=HOME=/var/lib/imagegen
Environment=CODEX_BIN=/usr/bin/codex
# Внутренняя песочница Codex (bubblewrap) не стартует внутри песочницы systemd —
# картинка генерировалась, но не сохранялась. Изоляцию даёт systemd ниже.
Environment=CODEX_SANDBOX=danger-full-access
ExecStart=/usr/bin/python3 /usr/local/lib/imagegen/imagegen-server.py
RuntimeDirectory=imagegen
RuntimeDirectoryMode=0755
LogsDirectory=imagegen
Restart=on-failure
RestartSec=5

# Песочница: промпт уходит Codex-агенту, поэтому даже при попытке prompt injection
# он не должен видеть файлы ботов и системы.
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/imagegen
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
